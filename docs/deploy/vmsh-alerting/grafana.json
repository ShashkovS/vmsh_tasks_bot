              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "2m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "critical",
            "component": "cpu",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "CPU выше 95 процентов больше двух минут",
            "description": "Найти потребителя CPU и проверить доступность форм и очереди; не перезапускать вслепую."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "10s",
            "group_interval": "5m",
            "repeat_interval": "1h"
          }
        },
        {
          "uid": "vmsh-health-apierrors",
          "title": "VmshApiErrors",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((sum by(instance,route) (increase(vmsh_http_requests_total{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",route=~\"/(student|family|staff)/api/v1/.*\",status=~\"5..\"}[5m])) >= 5)\nand on(instance,route)\n(sum by(instance,route) (increase(vmsh_http_requests_total{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",route=~\"/(student|family|staff)/api/v1/.*\",status=~\"5..\"}[5m])) / sum by(instance,route) (increase(vmsh_http_requests_total{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",route=~\"/(student|family|staff)/api/v1/.*\"}[5m])) > 0.05)) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
