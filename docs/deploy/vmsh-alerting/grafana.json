{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "vmsh-telegram",
      "receivers": [
        {
          "uid": "vmsh-health-telegram",
          "type": "telegram",
          "disableResolveMessage": false,
          "settings": {
            "bottoken": "$VMSH_ALERT_BOT_TOKEN",
            "chatid": "$VMSH_ALERT_CHAT_ID",
            "message": "ВМШ — {{ if eq .Status \"firing\" }}проблема{{ else }}восстановлено{{ end }}\n{{ range .Alerts.Firing }}⚠ {{ .Annotations.summary }}\n{{ if .Labels.route }}{{ .Labels.route }}\n{{ end }}{{ if .Labels.role }}SQLite: {{ .Labels.role }}\n{{ end }}{{ if .Labels.job }}Job: {{ .Labels.job }}\n{{ end }}{{ end }}{{ range .Alerts.Resolved }}✅ {{ .Annotations.summary }}\n{{ end }}Графики: https://grafvmsh.shashkovs.ru/"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "orgId": 1,
      "name": "vmsh-production",
      "folder": "VMSh Alerts",
      "interval": "30s",
      "rules": [
        {
          "uid": "vmsh-health-webunavailable",
          "title": "VmshWebUnavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((max by(instance) ((1 - up{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\"}) or (1 - nginx_up{job=\"nginx\",instance=\"vmsh.shashkovs.ru\"})) > 0)\nor absent(up{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\"})) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "1m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "critical",
            "component": "availability",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "Backend или nginx недоступен больше минуты",
            "description": "Проверить vmsh service, nginx и последние ошибки; короткий перезапуск не вызывает алерт."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "10s",
            "group_interval": "5m",
            "repeat_interval": "1h"
          }
        },
        {
          "uid": "vmsh-health-monitoringunavailable",
          "title": "VmshMonitoringUnavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((up{job=\"prometheus\",instance=\"vmsh.shashkovs.ru\"} == 0)\nor absent(up{job=\"prometheus\",instance=\"vmsh.shashkovs.ru\"})) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "1m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "critical",
            "component": "monitoring",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "Prometheus недоступен или перестал собирать собственные метрики",
            "description": "Проверить prometheus service и доступ Grafana к datasource; остальные правила сохраняют состояние при ошибке запроса."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "10s",
            "group_interval": "5m",
            "repeat_interval": "1h"
          }
        },
        {
          "uid": "vmsh-health-exporterunavailable",
          "title": "VmshExporterUnavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((up{job=~\"node|nginx|nats\",instance=\"vmsh.shashkovs.ru\"} == 0)\nor absent(up{job=\"node\",instance=\"vmsh.shashkovs.ru\"})\nor absent(up{job=\"nginx\",instance=\"vmsh.shashkovs.ru\"})\nor absent(up{job=\"nats\",instance=\"vmsh.shashkovs.ru\"})) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "2m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "warning",
            "component": "monitoring",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "Источник метрик недоступен больше двух минут",
            "description": "Проверить указанный job; для NATS проверить также сам сервер, поскольку он нужен realtime."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          }
        },
        {
          "uid": "vmsh-health-cpuhigh",
          "title": "VmshCpuHigh",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node\",instance=\"vmsh.shashkovs.ru\",mode=\"idle\"}[1m]))) > 80)\nand on(instance) (100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node\",instance=\"vmsh.shashkovs.ru\",mode=\"idle\"}[1m]))) <= 95)) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "2m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "warning",
            "component": "cpu",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "CPU выше 80 процентов больше двух минут",
            "description": "Проверить процессы, очереди SQLite и задержки API. При CPU выше 95 действует отдельное критическое правило."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          }
        },
        {
          "uid": "vmsh-health-cpucritical",
          "title": "VmshCpuCritical",
          "condition": "B",
