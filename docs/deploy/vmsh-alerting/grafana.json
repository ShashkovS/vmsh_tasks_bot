          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "30s",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "warning",
            "component": "sqlite",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
