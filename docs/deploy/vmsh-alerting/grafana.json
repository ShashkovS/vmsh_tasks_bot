              "model": {
                "refId": "A",
                "expr": "((sum by(instance) (increase(vmsh_event_loop_lag_seconds_count{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\"}[5m])) - sum by(instance) (increase(vmsh_event_loop_lag_seconds_bucket{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",le=\"0.2\"}[5m]))) >= 5) * 0 + 1",
                "instant": true,
