            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "1m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "critical",
            "component": "api",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "Повторяются ошибки API: минимум пять 5xx и больше пяти процентов за пять минут",
            "description": "Проверить route и серверную причину. 401, ограничения попыток 422 и запросы сканеров вне PWA не учитываются."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "10s",
            "group_interval": "5m",
            "repeat_interval": "1h"
          }
        },
        {
          "uid": "vmsh-health-interactiveslow",
          "title": "VmshInteractiveSlow",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((histogram_quantile(0.95, sum by(instance,route,le) (rate(vmsh_http_request_duration_seconds_bucket{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",method=\"GET\",route=~\"/(student|family|staff)/api/v1/.*\",route!~\".*(attachments|statistics|analytics|content/uploads|recheck|export|print|pdf).*\"}[5m]))) > 1)\nand on(instance,route) (sum by(instance,route) (increase(vmsh_http_request_duration_seconds_count{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",method=\"GET\"}[5m])) >= 30)) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "3m",
          "keepFiringFor": "1m",
          "isPaused": false,
          "labels": {
            "severity": "warning",
            "component": "latency",
            "instance": "vmsh.shashkovs.ru",
            "service": "vmsh"
          },
          "annotations": {
            "summary": "Интерактивный API p95 дольше секунды в течение трёх минут",
            "description": "Не менее 30 GET за пять минут; тяжёлые файлы и отчёты исключены. Проверить read queue и SQL владельцев слотов."
          },
          "notification_settings": {
            "receiver": "vmsh-telegram",
            "group_by": [
              "instance",
              "severity"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          }
        },
        {
          "uid": "vmsh-health-dbqueue",
          "title": "VmshDbQueue",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((max by(instance,role) (vmsh_db_waiting{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",role=\"read\"}) > 20)\nor (max by(instance,role) (vmsh_db_waiting{job=\"aiohttp\",instance=\"vmsh.shashkovs.ru\",role=\"write\"}) > 5)) * 0 + 1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
