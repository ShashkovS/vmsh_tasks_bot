{
  "name": "@vmsh/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "VMSH 179 student, family, teacher and administrator web applications",
  "license": "MIT",
  "author": "Sergey Shashkov",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11.15 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n student,family,staff -c cyan,green,magenta \"pnpm --filter @vmsh/student dev\" \"pnpm --filter @vmsh/family dev\" \"pnpm --filter @vmsh/staff dev\"",
    "dev:student": "pnpm --filter @vmsh/student dev",
    "dev:family": "pnpm --filter @vmsh/family dev",
    "dev:staff": "pnpm --filter @vmsh/staff dev",
    "routes:generate": "pnpm --if-present --recursive routes:generate",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm routes:generate && pnpm --recursive --if-present typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006} --no-open",
    "storybook:build": "storybook build",
    "storybook:test": "vitest run --config vitest.storybook.config.ts",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.0.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vmsh/app-shell": "workspace:*",
    "@vmsh/test-utils": "workspace:*",
    "@vmsh/ui": "workspace:*",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.0.0",
    "msw-storybook-addon": "^2.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.0.0",
    "storybook": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.0",
    "workbox-background-sync": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  }
}
