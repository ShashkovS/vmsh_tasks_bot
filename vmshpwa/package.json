{
  "name": "@vmsh/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "VMSH 179 student, family, teacher and administrator web applications",
  "license": "MIT",
  "author": "Sergey Shashkov",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11.15 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n student,family,staff -c cyan,green,magenta \"pnpm --filter @vmsh/student dev\" \"pnpm --filter @vmsh/family dev\" \"pnpm --filter @vmsh/staff dev\"",
    "dev:student": "pnpm --filter @vmsh/student dev",
    "dev:family": "pnpm --filter @vmsh/family dev",
    "dev:staff": "pnpm --filter @vmsh/staff dev",
    "routes:generate": "pnpm --if-present --recursive routes:generate",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm routes:generate && pnpm --recursive --if-present typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006} --no-open",
    "storybook:build": "storybook build",
    "storybook:test": "vitest run --config vitest.storybook.config.ts",
    "e2e:prepare": "pnpm build",
    "e2e": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner",
    "e2e:auth": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode authentication",
    "e2e:content": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode content",
    "e2e:submissions": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode submissions",
    "e2e:functional": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode nonvisual",
    "e2e:realtime": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode realtime",
    "e2e:runtime-isolation": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode runtime-isolation",
    "e2e:visual": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode visual",
    "e2e:visual:update": "cd .. && UV_CACHE_DIR=.runtime/uv-cache uv run python -m vmshpwa.scripts.e2e_runner --mode visual-update"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@sentry/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@visx/responsive": "catalog:",
    "@visx/scale": "catalog:",
    "@visx/shape": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "d3-array": "catalog:",
    "d3-scale": "catalog:",
    "d3-shape": "catalog:",
    "dexie": "catalog:",
    "dompurify": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.0.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vmsh/app-shell": "workspace:*",
    "@vmsh/test-utils": "workspace:*",
    "@vmsh/ui": "workspace:*",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "msw": "catalog:",
    "msw-storybook-addon": "^2.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.0.0",
    "storybook": "^10.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.0",
    "workbox-background-sync": "catalog:",
    "workbox-cacheable-response": "catalog:",
    "workbox-core": "catalog:",
    "workbox-expiration": "catalog:",
    "workbox-precaching": "catalog:",
    "workbox-routing": "catalog:",
    "workbox-strategies": "catalog:"
  }
}
