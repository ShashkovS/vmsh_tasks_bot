# Copy to the rendered @@ENV_FILE@@ path, replace every marker and chmod 0600.
# Do not put VMSH_RUNTIME_PROFILE or VMSH_PWA_PROTOTYPE here: the unit fixes
# those two security-boundary values on ExecStart.
VMSH_INSTANCE=production
VMSH_DB_FILENAME=@@DATABASE_PATH@@
VMSH_MEDIA_ROOT=@@MEDIA_ROOT@@
VMSH_NATS_SERVER=nats://127.0.0.1:4222
VMSH_NATS_TOPIC_PREFIX=vmshpwa_production
VMSH_PWA_PUBLIC_ORIGINS_JSON={"student":["https://@@PUBLIC_HOST@@"],"family":["https://@@PUBLIC_HOST@@"],"staff":["https://@@PUBLIC_HOST@@"]}
VMSH_PWA_AUTH_SIGNING_KEYS_JSON=["@@AUTH_SIGNING_KEY@@"]
VMSH_PWA_REFRESH_PEPPER_B64=@@REFRESH_PEPPER_B64@@
VMSH_PWA_THROTTLE_PEPPER_B64=@@THROTTLE_PEPPER_B64@@
VMSH_PWA_TRUSTED_PROXY_HOPS=1
VMSH_PWA_TRUSTED_PROXY_UNIX_SOCKETS_JSON=["@@BACKEND_UNIX_SOCKET@@"]
VMSH_SENTRY_DSN=@@SENTRY_DSN@@
VMSH_SENTRY_RELEASE=@@RELEASE@@
VMSH_VAPID_PUBLIC_KEY=@@VAPID_PUBLIC_KEY@@
VMSH_VAPID_PRIVATE_KEY=@@VAPID_PRIVATE_KEY@@
VMSH_VAPID_SUBJECT=mailto:@@OPERATOR_EMAIL@@
