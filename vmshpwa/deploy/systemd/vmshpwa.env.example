# Copy this file to /web/vmsh_tasks_bot/vmshpwa/runtime/vmshpwa.env and chmod
# 0600. Application settings belong in creds_prod/vmsh_bot_config_prod.json;
# this file contains only the nginx -> PWA transport boundary.
# Do not put VMSH_RUNTIME_PROFILE or VMSH_PWA_PROTOTYPE here: the unit fixes
# those two security-boundary values on ExecStart.
VMSH_PWA_TRUSTED_PROXY_HOPS=1
VMSH_PWA_TRUSTED_PROXY_UNIX_SOCKETS_JSON=["/web/vmsh_tasks_bot/vmshpwa/runtime/vmshpwa.sock"]
