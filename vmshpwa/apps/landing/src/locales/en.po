#: apps/landing/src/main.tsx
msgid "{brandName} — математический кружок"
msgstr "{brandName} — math circle"

#: apps/landing/src/main.tsx
msgid "{brandName} — математический кружок для школьников и родителей"
msgstr "{brandName} — a math club for students and parents"

#: apps/landing/src/landing-page.tsx
msgid "{brandName} — математический кружок для школьников. Выберите нужный кабинет, чтобы открыть задачи, результаты занятий и новости."
