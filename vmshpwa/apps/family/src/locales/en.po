msgid "ВМШ 179"
msgstr "VMSh 179"

#: apps/family/src/main.tsx
msgid "ВМШ 179 — кабинет родителя"
msgstr "VMSh 179 — parent account"

#: apps/family/src/login-page.tsx
msgid "Войти"
msgstr "Sign in"

#: apps/family/src/login-page.tsx
msgid "Вход для этой учётной записи сейчас недоступен. Напишите администраторам."
msgstr "Sign-in for this account is unavailable right now. Please contact the administrators."

#: apps/family/src/login-page.tsx
msgid "Входим…"
msgstr "Signing in…"

#: apps/family/src/main.tsx
msgid "Готовим работу без сети"
msgstr "Preparing offline mode"

#: apps/family/src/routes/__root.tsx
msgid "Дети"
msgstr "Children"

#: apps/family/src/pwa-update.tsx
msgid "Доступно обновление."
msgstr "An update is available."

#: apps/family/src/pwa-update.tsx
msgid "Закрыть"
msgstr "Close"

#: apps/family/src/login-page.tsx
msgid "Кабинет родителя"
msgstr "Parent account"

#: apps/family/src/login-page.tsx
msgid "Логин"
msgstr "Login"

#: apps/family/src/login-page.tsx
msgid "Логин или пароль не подошли. Проверьте раскладку и попробуйте ещё раз."
msgstr "The login or password is incorrect. Check the keyboard layout and try again."

